			textAlignment west
		}

		ModBrowserSearch
		{
			ControlName TextEntry
			xpos 1278
			ypos 795
			wide 380
			tall 30
			zpos 100
			textHidden 0
			editable 1
			font Default_21
			allowRightClickMenu 0
			allowSpecialCharacters 1
			unicode 1
			navUp CardButton17
			navRight ModBrowserSort
			navDown ModBrowserSort
		}

		ModBrowserSort
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			xpos 1178
			ypos 832
			wide 500
			tall 36
			labelText "#MOD_BROWSER_SORT"
			list
			{
				"#MOD_BROWSER_SORT_RECENTLY_UPDATED" "bumped_at"
				"#MOD_BROWSER_SORT_PUBLISHED" "published_at"
				"#MOD_BROWSER_SORT_DOWNLOADS" "downloads"
				"#MOD_BROWSER_SORT_LIKES" "likes"
				"#MOD_BROWSER_SORT_VIEWS" "views"
				"#MOD_BROWSER_SORT_WEEKLY_SCORE" "weekly_score"
				"#MOD_BROWSER_SORT_DAILY_SCORE" "daily_score"
				"#MOD_BROWSER_SORT_BEST_MATCH" "best_match"
				"#MOD_BROWSER_SORT_RANDOM" "random"
			}
			navUp ModBrowserSearch
			navLeft ModBrowserSearch
			navDown ModBrowserFilter
		}

		ModBrowserFilter
		{
			ControlName RuiButton
			InheritProperties SwitchButton
			xpos 1178
			ypos 872
			wide 500
			tall 36
			labelText "#SHOW"
			list
			{
				"#MOD_BROWSER_FILTER_ALL_MODS" "0"
				"#MOD_BROWSER_FILTER_INSTALLED" "1"
				"#MOD_BROWSER_FILTER_UPDATES" "2"
			}
			navUp ModBrowserSort
			navLeft ModBrowserSort
			navDown ModBrowserSource
		}

