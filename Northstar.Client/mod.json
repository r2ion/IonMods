{
  "Name": "Northstar.Client",
  "Description": "Various ui and client changes to fix bugs and add better support for mods",
  "Version": "1.19.0",
  "Patch": 0,
  "LoadPriority": 0,
  "InitScript": "cl_northstar_client_init.nut",
  "ConVars": [
    {
      "Name": "filter_hide_empty",
      "DefaultValue": "0"
    },
    {
      "Name": "filter_hide_full",
      "DefaultValue": "0"
    },
    {
      "Name": "filter_hide_protected",
      "DefaultValue": "0"
    },
    {
      "Name": "filter_map",
      "DefaultValue": "0"
    },
    {
      "Name": "filter_gamemode",
      "DefaultValue": "0"
    },
    {
      "Name": "filter_mods",
      "DefaultValue": "0"
    },
    {
      "Name": "filter_map_hide_locked",
      "DefaultValue": "0"
    },
    {
      "Name": "modlist_show_convars",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "modlist_reverse",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "modlist_show_priority_headers",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "modemenu_mode_filter",
      "DefaultValue": "-1"
    },
    {
      "Name": "ns_communities_enabled",
      "DefaultValue": "1",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "hide_motd",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "hide_version",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "hide_subtext",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "hide_spotlight",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    },
    {
      "Name": "previous_mp_allowed",
      "DefaultValue": "-1"
    },
    {
      "Name": "previous_match_compat_mode",
      "DefaultValue": "-1",
      "Flags": "ARCHIVE"
    },
    {
      "Name": "serverlist_remove_colors",
      "DefaultValue": "0",
      "Flags": "ARCHIVE_PLAYERPROFILE"
    }
  ],
  "Scripts": [
    {
      "Path": "_custom_codecallbacks_client.gnut",
      "RunOn": "CLIENT"
    },
    {
      "Path": "_custom_codecallbacks_ui.gnut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "NSUICodeCallback_ConnectionCallbacksInit"
      }
    },
    {
      "Path": "_custom_codecallbacks_sh.gnut",
      "RunOn": "UI || CLIENT"
    },
    {
      "Path": "client/cl_chat.gnut",
      "RunOn": "CLIENT"
    },
    {
      "Path": "ui/menu_ns_modmenu.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddNorthstarModMenu",
        "After": "AddNorthstarModMenu_MainMenuFooter"
      }
    },
    {
      "Path": "ui/menu_ns_setversionlabel.nut",
      "RunOn": "UI"
    },
    {
      "Path": "presence/ui_presence.nut",
      "RunOn": "UI",
      "UICallback": {
        "After": "NSUpdateGameStateUIStart"
      }
    },
    {
      "Path": "presence/cl_presence.nut",
      "RunOn": "CLIENT",
      "ClientCallback": {
        "After": "NSUpdateGameStateClientStart"
      }
    },
    {
      "Path": "ui/menu_ns_moddownload.nut",
      "RunOn": "UI"
    },
    {
      "Path": "ui/menu_ns_serverbrowser.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddNorthstarServerBrowserMenu"
      }
    },
    {
      "Path": "ui/menu_ns_connect_password.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddNorthstarConnectWithPasswordMenu"
      }
    },
    {
      "Path": "ui/menu_ns_custom_match_settings.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddNorthstarCustomMatchSettingsMenu"
      }
    },
    {
      "Path": "ui/controller_prompts.nut",
      "RunOn": "UI"
    },
    {
      "Path": "ui/ns_slider.nut",
      "RunOn": "UI"
    },
    {
      "Path": "ui/menu_ns_color_picker.nut",
      "RunOn": "UI || CLIENT",
      "UICallback": {
        "After": "AddColorPickerMenu"
      }
    },
    {
      "Path": "ui/menu_mod_settings.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddModSettingsMenu"
      }
    },
    {
      "Path": "ui/ui_mouse_capture.nut",
      "RunOn": "UI"
    },
    {
      "Path": "ui/atlas_auth.nut",
      "RunOn": "UI"
    },
    {
      "Path": "ui/menu_dialog_hiddentextentry.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddDialogHiddenTextEntry"
      }
    },
    {
      "Path": "ui/menu_dialog_textentry.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddDialogTextEntry"
      }
    },
    {
      "Path": "ui/menu_playerlist.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddPlayerlistMenu"
      }
    },
    {
      "Path": "client/cl_playerlist.gnut",
      "RunOn": "(CLIENT && MP)"
    },
    {
      "Path": "ui/menu_demopicker.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddDemopickerMenu"
      }
    },
    {
      "Path": "ui/menu_friendslist.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddFriendslistMenu"
      }
    },
    {
      "Path": "client/cl_reparseweapons.gnut",
      "RunOn": "CLIENT",
      "ClientCallback": {
        "After": "Cl_WeaponReparse"
      }
    },
    {
      "Path": "ui/ns_client_mod_settings.gnut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "NSClientModSettings"
      }
    },
    {
      "Path": "ui/_atlas_announcements.nut",
      "RunOn": "UI"
    },
    {
      "Path": "client/cl_ns_compat.gnut",
      "RunOn": "(CLIENT && MP)",
      "ClientCallback": {
        "After": "NSClientSaveCompatMode"
      }
    },
    {
      "Path": "ui/menu_ns_modbrowser.nut",
      "RunOn": "UI",
      "UICallback": {
        "Before": "AddNorthstarModBrowserMenu"
      }
    }
  ],
  "Localisation": [
    "resource/northstar_client_localisation_%language%.txt"
  ]
}